# Server Port & Environment
PORT=3000
NODE_ENV=production

# App Hosting URL
APP_URL="https://your-domain.com"

# Email Integration (Microsoft 365 Graph / SMTP / IMAP)
M365_TENANT_ID="your-m365-tenant-id"
M365_CLIENT_ID="your-m365-client-id"
M365_CLIENT_SECRET="your-m365-client-secret"
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_USER="helpdesk@company.com"
SMTP_PASSWORD="your-smtp-app-password"

# Optional Gemini API Key (Disabled by default per Section 27)
GEMINI_API_KEY=""
